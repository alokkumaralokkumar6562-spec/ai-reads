# AI Reads - Server Environment Variables
PORT=5001
NODE_ENV=development
JWT_SECRET=ai-reads-jwt-production-secret-change-in-prod-2026

# Razorpay Payment Gateway Credentials (Optional in test mode, provided for production)
# Sign up at https://dashboard.razorpay.com to get your test/live keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# OpenAI API Key (Optional: system uses smart educational engine fallback when omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase Configuration (Optional for cloud sync; local file-based DB active by default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
